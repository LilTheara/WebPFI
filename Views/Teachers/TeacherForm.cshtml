@model Models.Teacher
@{
	bool createMode = Model.Id == 0;
	string pageTitle = createMode ? "Add Teacher" : "Edit Teacher";
}

@using (Html.BeginForm())
{
	@Html.AntiForgeryToken() <!-- Injection de jeton anti contrefaçon de formulaire -->
<details id="teacher_edits_@Model.Code">
	<summary>Informations - [@Model.Code]</summary>
	<fieldset>
		<legend>Prénom</legend>
		<input id="FirstName"
			   name="FirstName"
			   class="form-control"
			   placeholder="Titre"
			   value="@Model.FirstName"
			   required
			   RequireMessage="Veuillez entrer un prénom" />
	</fieldset>
	<fieldset>
		<legend>Nom</legend>
		<input id="LastName"
			   name="LastName"
			   class="form-control"
			   placeholder="Titre"
			   value="@Model.LastName"
			   required
			   RequireMessage="Veuillez entrer un nom" />
	</fieldset>
	<fieldset>
		<legend>Date d'embauche</legend>
		<input name="Start" class="form-control datepicker" value="@Model.StartDate.ToString("yyyy-MM-dd")"
			   required
			   RequireMessage="Veuillez entrer une date"
			   InvalidMessage="Date invalide" />
	</fieldset>
	<fieldset>
		<legend>Téléphone</legend>
		<input class="form-control Phone"
			   name="Phone"
			   id="Phone"
			   placeholder="(000) 000-0000"
			   required
			   RequireMessage="Veuillez entrer un numéro de téléphone"
			   InvalidMessage="Téléphone invalide"
			   value="@Model.Phone" />
	</fieldset>
	<fieldset>
		<legend>Avatar</legend>
		@Helper.ImageUploader("Avatar", Model.Avatar, "Cliquez glisser une photo")
	</fieldset>
</details>
	if (!createMode)
	{
		var courses = Model.CoursesToSeleclist();
		var allCourses = DAL.DB.Courses.ToSelectList();
		<details style="display: block; width: 100%;">
			<summary>Allocations : @NextSession.Caption</summary>
			<fieldset>
				@Helper.SelectionLists("SelectedCourses", courses, allCourses)
			</fieldset>
		</details>
	}
	<input id="submit" type="submit" value="Enregistrer" class="btn btn-primary" style="display:none">

}
