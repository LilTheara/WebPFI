@model Models.Course

@if (Model != null)
{
    <div>
        <div style="font-size:1.3em; font-weight:bold;">@Model.Code</div>
        <div style="font-size:1.1em; font-weight:bold;">Session @Model.Session</div>
        <div style="font-weight:900; margin-top:6px;">@Model.Title</div>
    </div>

    <hr />

    <h5>Étudiants inscrits</h5>

    var yearsList = Model.Students.Select(s => s.Year).Distinct().OrderByDescending(y => y).ToList();

    foreach (int year in yearsList)
    {
        var students = Model.Students.Where(s => s.Year == year).OrderBy(s => s.LastName).ThenBy(s => s.FirstName).ToList();

        if (students.Count() > 0)
        {
            <details id="course_students_details_@year">
                <summary>Cohorte @year</summary>

                @foreach (var student in students)
                {
                    <div class="StudentListLayout">
                        <a href="/Students/Details/@student.Id">
                            <div style="display:flex">
                                <span class="studentCode">@student.Code</span>
                                <div class="studentName">@student.LastName @student.FirstName</div>
                            </div>
                        </a>
                    </div>
                }
            </details>
        }
    }
}
else
{
    <h2 style="color:red">Ce cours a été effacé...</h2>
}