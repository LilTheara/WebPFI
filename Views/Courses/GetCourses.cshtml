@using System.Collections.Generic
@using System.Linq
@model IEnumerable<Models.Course>

@{
    List<Models.Course> coursesList =
        Model != null ? Model.ToList() : new List<Models.Course>();

    List<int> sessionsList =
        coursesList.Select(course => course.Session).Distinct().OrderBy(session => session).ToList();
}

@foreach (int session in sessionsList)
{
    List<Models.Course> courses =
        coursesList.Where(course => course.Session == session).OrderBy(course => course.Code).ToList();

    if (courses.Count() > 0)
    {
        <details id="courses_details_@session">
            <summary>Session @session</summary>

            @foreach (Models.Course course in courses)
            {
                <div class="StudentListLayout">
                    <a href="@Url.Action("Details", "Courses", new { id = course.Id }, null)">
                        <div style="display:flex">
                            <span class="courseCode">@course.Code</span>
                            <div class="courseTitle">@course.Title</div>
                        </div>
                    </a>
                </div>
            }
        </details>
    }
}