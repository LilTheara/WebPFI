@model Registrar.Models.Course

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <details id="course_edits_@Model.Code" open>
        <summary>Informations - [@Model.Code]</summary>

        <fieldset>
            <legend>Code</legend>
            <input id="Code"
                   name="Code"
                   class="form-control"
                   placeholder="Code"
                   value="@Model.Code"
                   required
                   RequireMessage="Veuillez entrer un code" />
        </fieldset>

        <fieldset>
            <legend>Titre</legend>
            <input id="Title"
                   name="Title"
                   class="form-control"
                   placeholder="Titre"
                   value="@Model.Title"
                   required
                   RequireMessage="Veuillez entrer un titre" />
        </fieldset>

        <fieldset>
            <legend>Session</legend>
            <input id="Session"
                   name="Session"
                   class="form-control"
                   type="number"
                   min="1"
                   max="6"
                   value="@Model.Session"
                   required
                   RequireMessage="Veuillez entrer une session" />
        </fieldset>
    </details>

    <details id="course_registrations_@Model.Code">
        <summary>Inscriptions : @NextSession.Caption</summary>

        <div style="display:flex; gap:20px; margin-top:10px;">

            <div style="flex:1;">
                <div style="font-weight:bold; margin-bottom:6px;">
                    Étudiants inscrits
                </div>

                <select class="form-control"
                        size="12"
                        style="height:250px; font-family:monospace;">
                </select>
            </div>

            <div style="flex:1;">
                <div style="font-weight:bold; margin-bottom:6px;">
                    Étudiants disponibles
                </div>

                <select class="form-control"
                        size="12"
                        style="height:250px; font-family:monospace;">
                </select>
            </div>

        </div>
    </details>

    <input id="submit" type="submit" value="Enregistrer" class="btn btn-primary" style="display:none">
}