@{
	ViewBag.PageTitle = "Étudiants";
	string search = Session["Search"] != null ? ((bool)Session["Search"]).ToString() : false.ToString();
}

<div id="StudentListPanel" class="studentListLayout">
	<!-- Periodicaly refreshed by object contactListPanel of class AutoRefreshedPanel -->
</div>

@section Scripts {
	<script>

        let studentsListAutoRefreshPanel = null;
        let yearsSelectAutoRefreshPanel = null;
        let loadMoreTriggerMargin = 10;
        let pauseScrollEvent = false;

        $(() => {
            newSession(600);
            //setCurrentPageLimit();

            studentsListAutoRefreshPanel =
                new AutoRefreshedPanel(
                    "StudentListPanel",
                    "/Students/GetStudents",
                    10,
                    studentsListPostRefresh);
			yearsSelectAutoRefreshPanel =
				new AutoRefreshedPanel(
					"yearSelectPanel",
					"/Students/GetYearsList",
					-1 /* manually refreshed */,
					yearsSelectPostRefresh);

            let keywordsOnchangeTimer = null;
            let resizeTimer = null;
            let resizeEndTriggerDelai = 300;
            let minKeywordLenth = 3;

            // install rezise viewport event handler in orther to set Students/List vue firstpage size
            $(window).on('resize', function (e) {
                studentsListAutoRefreshPanel.pause();
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(() => {
                    setCurrentPageLimit();
                    studentsListAutoRefreshPanel.restart();
                    studentsListAutoRefreshPanel.refresh(true);
                }, resizeEndTriggerDelai);
            });

            function setCurrentPageLimit() {
				let nbColumns = 3; // at worse there will be 3 students per row.
                let nbRows = 4; // default value that will change with windows.resize events
                let pageSize = nbRows * nbColumns + nbColumns;
				let studentLayout = $(".studentLayout").first();

				if (studentLayout != null) {
					let nbRows = Math.round($("#mainContentPanel").innerHeight() / studentLayout.outerHeight());
                    pageSize = nbRows * nbColumns + nbColumns /* make sure to always have a content overflow */;
                }
                console.log("pageSize ", pageSize)
                if (pageSize != NaN)
					$.ajax({ url: `/Students/SetFirstPageSize?pageSize=${pageSize}` });
            }
            // Load on demand handling (infinite scroll)
            $("#mainContentPanel").scroll(function () {
                let scrollPanel = $(this);
                if (!pauseScrollEvent) {
					if ((scrollPanel.scrollTop() + scrollPanel.outerHeight() >= $("#StudentListPanel").outerHeight() - loadMoreTriggerMargin)) {
                        pauseScrollEvent = true;
                        $.ajax({
							url: "/Students/getNextStudentsPage",
                            dataType: "html",
                            success: (htmlContent) => {
                                studentsListAutoRefreshPanel.appendContent(htmlContent);
                                pauseScrollEvent = false;
                            },
                            statusCode: { 401: this.redirect }
                        })
                    }
                }
            })
            $("#searchInput").on('keyup', function () {
                clearTimeout(keywordsOnchangeTimer);
                /* delay request by 0.5 seconds */
                keywordsOnchangeTimer = setTimeout(() => {
					window.location = "/Students/SetSearchString?value=" + $("#searchInput").val();
                }, 1000 /* 1 seconds */);
            });
            $("#searchInput").on('search', function () { /* click on clear */
                clearTimeout(keywordsOnchangeTimer);
				window.location = "/Students/SetSearchString?value=" + $("#searchInput").val();
            });
            $("#searchInput").on("focus", function () {
                studentsListAutoRefreshPanel.pause();
            });
            $("#searchInput").on("blur", function () {
                studentsListAutoRefreshPanel.restart();
            });

			function studentsListPostRefresh(fromRefresh = true) {
                if (fromRefresh) {
                    yearsSelectAutoRefreshPanel.refresh(true)
                    $(".toggleLikeCmd").off();
                    $(".toggleLikeCmd").click(function (e) {
						studentsListAutoRefreshPanel.command("/Students/ToggleStudentLike/" + $(this).attr("studentId"));
                        e.preventDefault();
                    });
                }
				$(".studentThumbnail").off();
				$(".studentThumbnail").on("click", function () {
                    let scrollPanel = $("#mainContentPanel");
                    sessionStorage.setItem("previousScrollPosition", scrollPanel.scrollTop());
                })
                let scrollPanel = $("#mainContentPanel");
                let scrollPos = sessionStorage.getItem("previousScrollPosition");
                let RestoreScrollPosition = sessionStorage.getItem("RestoreScrollPosition");
                // Restore scroll position
                if (RestoreScrollPosition != null && scrollPos != null) {
                    scrollPanel.scrollTop(parseInt(scrollPos));
                }
                sessionStorage.clear("RestoreScrollPosition");
                highlightKeyword();
                RestoreDetailsState();
            }

			function yearsSelectPostRefresh() {
				$("#yearSelect").off();
				$("#yearSelect").on("focus", function () {
					studentsListAutoRefreshPanel.pause();
				});
				$("#yearSelect").on("blur", function () {
					studentsListAutoRefreshPanel.restart();
				});
				$("#yearSelect").on('change', function () {
					window.location = "/Students/SetSearchYear?value=" + $("#yearSelect").val();
				});
			}

            function highlightKeyword() {
                if ("@search" == "True") {
                    let keyword = $("#searchInput").val();
                    if (keyword.length > 0) {
						let names = document.getElementsByClassName('studentName');
						Array.from(names).forEach(name => {
							highlight(keyword, name);
                        })
                    }
                }
            }
            function RestoreDetailsState() {
                //install event handler ?
                $("details").off();
                $("details").on('toggle', function () {
                    let details_dom = $(this)[0];
                    if (details_dom != undefined) {
                        // Save detail state
                        localStorage.setItem(details_dom.id, details_dom.open);
                    }
                })
                // Restore state of each details tags
                for (let i = 0; i < localStorage.length; i++) {
                    const key = localStorage.key(i);
                    // target only keys that contains "details" string
                    if (key.indexOf("details") > -1) {
                        let details_dom = $("#" + key)[0];
                        if (details_dom != undefined)
                            // all values in localstorage are stored as string
                            details_dom.open = localStorage.getItem(key) == "true";
                        let i = 0;
                    }
                }
            }
        })
	</script>
}