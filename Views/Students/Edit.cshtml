@model Models.Student
@{
	ViewBag.Action = "Edit";
	Html.RenderPartial("StudentForm");
	ViewBag.PageTitle = "Modification";
}

@section Scripts {  <!-- Cette section ne doit pas être placée dans une vue partielle -->
	<script>$(() => {

            initFormValidation();
            addConflictValidation("/Students/CheckConflict", 'Email' /* field unicity check */, 'submit' /* form submit button Id */);
        })</script>
}